# ==============================================================================
# PHISHGUARD AI — Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend Settings (apps/web)
NEXT_PUBLIC_APP_NAME="PhishGuard AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_ENABLE_DEMO_DATA=true

# Backend Settings (apps/api)
PROJECT_NAME="PhishGuard AI Backend API"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Database Configuration (PostgreSQL / SQLite fallback for lightweight local dev)
# For PostgreSQL: postgresql+asyncpg://phishguard:phishguard_pass@localhost:5432/phishguard_db
# For SQLite fallback: sqlite+aiosqlite:///./phishguard.db
DATABASE_URL="sqlite+aiosqlite:///./phishguard.db"
DATABASE_SYNC_URL="sqlite:///./phishguard.db"

# MongoDB Configuration (Persists users string credentials and timestamped activity history)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="phishguard_db"
MONGODB_ENABLED=true
MONGODB_TIMEOUT_MS=3000

# Security & JWT Authentication
# Generate a strong 256-bit secret key in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="phishguard-dev-super-secret-jwt-signing-key-replace-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
SCAN_RATE_LIMIT_PER_MINUTE=20

# ML Artifacts Paths (relative to backend root or absolute)
MODEL_ARTIFACTS_DIR="../../ml/artifacts"
URL_MODEL_PATH="../../ml/artifacts/url_phishing_model.joblib"
URL_SCALER_PATH="../../ml/artifacts/url_scaler.joblib"
URL_FEATURE_NAMES_PATH="../../ml/artifacts/url_features.json"
NLP_MODEL_PATH="../../ml/artifacts/nlp_scam_model.joblib"
NLP_VECTORIZER_PATH="../../ml/artifacts/nlp_vectorizer.joblib"

# Admin Initial Credentials (Optional seeding)
FIRST_SUPERUSER_EMAIL="admin@phishguard.ai"
FIRST_SUPERUSER_PASSWORD="AdminSecurePassword123!"
