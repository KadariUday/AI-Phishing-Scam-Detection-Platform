FROM python:3.11-slim

WORKDIR /app

# Install build essentials for C-extensions if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy backend requirements
COPY apps/api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy ML training code & artifacts
COPY ml /app/ml

# Run ML artifact generation if needed
RUN python ml/training/train_all.py

# Copy API application source
COPY apps/api /app/apps/api

ENV PYTHONPATH=/app/apps/api:/app

EXPOSE 8000

CMD ["uvicorn", "apps.api.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
